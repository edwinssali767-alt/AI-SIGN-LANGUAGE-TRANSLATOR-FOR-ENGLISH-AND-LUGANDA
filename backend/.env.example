# MongoDB Atlas Configuration
MONGODB_URI=your_mongodb_atlas_connection_string_here
MONGODB_DB_NAME=sign_language_translator

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary Folders
CLOUDINARY_PROFILE_IMAGES_FOLDER=profile_images
CLOUDINARY_LEARNING_VIDEOS_FOLDER=learning_videos
CLOUDINARY_GESTURE_IMAGES_FOLDER=gesture_images
CLOUDINARY_CAPTURED_GESTURES_FOLDER=captured_gestures

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
TESTING=False

# Confidence Threshold
CONFIDENCE_THRESHOLD=0.5

# SMTP Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
SEND_LOGIN_WELCOME_EMAIL=true